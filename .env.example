# Copy this file to .env and set a unique random JWT secret of at least 32 bytes.
DATABASE_URL=postgresql+asyncpg://speech:speech@localhost:15432/speech
REDIS_URL=redis://localhost:16379/0
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Estimated local-model usage cost in USD per 1 million tokens; set rates for your provider if applicable.
PROMPT_COST_PER_MILLION_TOKENS_USD=0
COMPLETION_COST_PER_MILLION_TOKENS_USD=0
CORS_ORIGINS=http://localhost:4566,http://127.0.0.1:4566,http://localhost:8000
# Native FastAPI uses localhost; if FastAPI runs in Docker, use http://host.docker.internal:11434.
OLLAMA_URL=http://localhost:11434
# Keep llama3.2 for the 3.2B model; llama3:latest uses the larger 8B model and is slower.
OLLAMA_MODEL=llama3.2
